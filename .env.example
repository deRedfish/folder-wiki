# Host port opened by Docker Compose.
FOLDER_WIKI_PORT=4173

# Persistent host directory mounted into the container. It contains both wiki
# files and the hidden .folder-wiki database/runtime directory.
FOLDER_WIKI_CONTENT=./content

# Linux user/group IDs that own the content directory. Find them with `id -u`
# and `id -g` so the container can use an existing .folder-wiki directory.
FOLDER_WIKI_UID=1000
FOLDER_WIKI_GID=1000
